# Render Environment Variables Template
# Copy these to your Render dashboard for each service

# ========================================
# ML SERVICE (digiscribe-ml)
# ========================================
PYTHON_VERSION=3.11

# ========================================
# BACKEND (digiscribe-backend)
# ========================================
SPRING_PROFILES_ACTIVE=render
ML_SERVICE_URL=https://digiscribe-ml-XXXX.onrender.com/api
DATABASE_URL=<auto-provided-by-render-postgres>
CORS_ORIGINS=https://digiscribe-frontend-XXXX.onrender.com

# ========================================
# FRONTEND (digiscribe-frontend)
# ========================================
VITE_API_BASE_URL=https://digiscribe-backend-XXXX.onrender.com/api
VITE_ENV=production

# ========================================
# NOTES
# ========================================
# Replace XXXX with your actual Render service names
# DATABASE_URL is automatically provided when you link PostgreSQL
# Update URLs after each service is created
